---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MethodList from '../components/MethodList.astro';
import CalEmbed from '../components/CalEmbed.astro';

const gets = [
  "An honest read on what's being counted as a conversion, and whether those conversions are real.",
  'Which sales the platform currently cannot see, and what it would take to fix that.',
  'The two or three changes with the largest expected effect, in priority order.',
  "What I don't know yet, and what it would take to find out.",
];
---

<Base
  title="Free marketing assessment | Project Pineapple"
  description="Thirty minutes in your ad account. Find out what's being counted as a conversion and what would actually move revenue. You keep the findings."
>
  <Header variant="minimal" sectionLinks={true} cta={false} />

  <section class="hero">
    <div class="hero__inner">
      <h1>The free marketing assessment</h1>
      <p class="lead hero__sub">Thirty minutes in your account and your numbers. No pitch, no deck.</p>
    </div>
  </section>

  <section class="split">
    <div class="split__grid">
      <div class="split__col quad">
        <h2 class="display-3 split__h">What happens</h2>
        <div class="stack">
          <p class="body">
            You give me read-only access to your Google Ads account and tell me roughly what a new customer is
            worth to you. If you don't know, that's fine, and it's usually the first thing worth figuring out.
          </p>
          <p class="body">
            I spend time in the account before we talk. Then we get on a call for thirty minutes and I walk you
            through what I found.
          </p>
          <p class="body">
            If the ads aren't really the problem, that's fine too. A lot of the time it's numbers that don't match
            across systems, leads that don't get followed up, or fees eating into margin. Those are worth thirty
            minutes as well.
          </p>
        </div>
      </div>
      <div class="split__col quad quad--cream2">
        <h2 class="display-3 split__h">What you'll get</h2>
        <MethodList items={gets} compact />
      </div>
    </div>
  </section>

  <section class="split split--sm">
    <div class="split__grid">
      <div class="split__col">
        <h2 class="display-3 split__h split__h--sm">What happens after</h2>
        <p class="body">
          You keep all of it. If you want to hand it to your current agency and have them fix it, that's a fine
          outcome. If you'd rather I do it, we'll talk about what that looks like and I'll send a written scope.
        </p>
      </div>
      <div class="split__col">
        <h2 class="display-3 split__h split__h--sm">Who it's for</h2>
        <p class="body">
          For the ad account review, businesses spending at least $3,000 a month on advertising. Below that there
          usually isn't enough data to say much with confidence. For data and operations work there's no minimum ad
          spend. It just needs enough volume that the numbers matter.
        </p>
      </div>
    </div>
  </section>

  <section id="book" class="book">
    <h2 class="display-2 book__h">Pick a time</h2>
    <CalEmbed />
  </section>

  <Footer />
</Base>

<style>
  .hero {
    padding: var(--pad-hero) var(--gutter) var(--pad-secondary);
    border-bottom: 1px solid var(--hairline);
  }
  .hero h1 {
    margin: 0 0 clamp(20px, 2.4vw, 32px);
    font: 400 clamp(40px, 6.2vw, 88px) / 1 var(--display);
    letter-spacing: -0.024em;
    text-wrap: balance;
    max-width: 16ch;
  }
  .hero__sub {
    max-width: 44ch;
  }

  .split {
    border-bottom: 1px solid var(--hairline);
  }
  .quad--cream2 {
    background: var(--cream-2);
  }
  .stack {
    display: grid;
    gap: 20px;
    max-width: 56ch;
  }
  .split--sm .body {
    max-width: 52ch;
  }

  .book {
    padding: var(--pad-secondary) var(--gutter);
    background: var(--sand);
    border-bottom: 1px solid var(--hairline);
  }
  .book__h {
    margin-bottom: clamp(24px, 3vw, 40px);
  }
</style>
