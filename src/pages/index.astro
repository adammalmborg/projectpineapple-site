---
/**
 * Home. The copy is approved; the layout is what this file is about.
 *
 * Every section is a full-bleed band. Product screens are demo data and each
 * one is captioned that way.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaLink from '../components/CtaLink.astro';
import Portrait from '../components/Portrait.astro';
import ProductShot from '../components/ProductShot.astro';
import dashboardMobile from '../assets/product/dashboard-mobile.webp';
import dashboardMonth from '../assets/product/dashboard-month.webp';
import screenMonth from '../assets/product/screen-month.webp';
import cropCost from '../assets/product/crop-cost.webp';
import cropChart from '../assets/product/crop-chart.webp';
import cropLeads from '../assets/product/crop-leads.webp';
import ClosingCta from '../components/ClosingCta.astro';
import PineList from '../components/PineList.astro';
import Steps from '../components/Steps.astro';
import { CTA_MICROCOPY_HOME } from '../content/site';
import { testimonials } from '../content/testimonials';

const featured = testimonials[0];

const facts = [
  { label: 'Revenue fit', value: '$500K–$10M' },
  { label: 'Media', value: '$3K+ / month' },
  { label: 'Fee', value: 'Flat monthly' },
];

const problems = [
  { heading: 'Leads that never became customers.', body: "The dashboard climbs. The bank account doesn't." },
  { heading: "Calls the platform can't see.", body: 'The phone is where the money is decided.' },
  { heading: 'Budget going to the wrong people.', body: 'The platform is doing what it was told.' },
  { heading: 'Cost per lead looks like progress.', body: 'It can fall while revenue falls with it.' },
];

const layers = [
  {
    heading: 'Getting the right customers',
    body: 'Running Google and Meta so they find people who actually buy, instead of people who just fill out a form.',
    shot: cropCost,
    alt: 'A table from the client dashboard showing the cost of a booking by paid channel over five months, with demo data',
    caption: 'What a booking costs on each channel, month by month. Demo data.',
    mat: 'sand',
  },
  {
    heading: 'Knowing your numbers',
    body: 'Getting spend, bookings, and payments into one place, so you can make calls on budget, pricing, and staffing based on what actually happened.',
    shot: cropChart,
    alt: 'A chart from the client dashboard comparing monthly ad spend with what the customers from those ads went on to pay, with demo data',
    caption: 'What you paid for ads next to what those customers paid you. Demo data.',
    mat: 'pine',
  },
  {
    heading: 'Turning more of them into revenue',
    body: 'Follow-up, scheduling, financing, pricing, card fees. Small fixes here often make more difference than more ad spend.',
    shot: cropLeads,
    alt: 'The leads board from the client dashboard, showing new and contacted leads and how long each has been waiting, with demo data',
    caption: 'The leads board, with how long each lead has been waiting. Demo data.',
    mat: 'sand',
    bleed: true,
  },
];

const engagements = [
  {
    label: 'Most clients',
    name: 'Paid advertising, measured by revenue',
    intro:
      "I run the paid advertising and connect it to the customers who actually paid. For a lot of businesses this is the right amount.",
    includes: [
      'Google Ads and your other paid channels, run day to day',
      'Call tracking and CRM data connected back to the campaigns',
      'A customer value by service or case type, so the bidding knows what a good customer is',
      "A monthly report on what you spent, what came back, and what can't be attributed yet",
      'A flat monthly fee',
    ],
  },
  {
    label: 'Some clients',
    name: 'Marketing and operating leadership',
    intro:
      "Some businesses need someone to own the whole function, and the numbers underneath it. That starts with measurement and ends up in decisions about pricing, capacity, and vendors. It's a different scope, priced separately.",
    includes: [
      'Every lead source measured, not just the paid ones: referrals, directories, agencies, your own site',
      'Your booking, sales, and payment systems reporting into one place you can make decisions from',
      'Pricing and margin, including the fees sitting between you and your revenue, like payment processing',
      'The sales process itself: follow-up, financing, scheduling, the steps between a lead and a paid customer',
      'Other vendors held to the same numbers',
      'Part of the conversations where decisions get made, instead of reporting on them afterward',
    ],
  },
];

const method = [
  'Establish what a customer is worth. Every decision after that depends on it.',
  "Connect the sale back to its source. That means call tracking, CRM data, and a hard look at what's being counted.",
  'Rebuild the campaigns around revenue. Same budget, different people.',
  "Report on what actually happened, including what I can't attribute yet.",
];
---

<Base
  title="Project Pineapple | Marketing and growth for owner-run businesses"
  description="Paid advertising, reporting, and operations help for owner-run businesses. Since 2014, I've been doing this for clients and for my own businesses. Flat monthly fee. Salt Lake City, clients nationwide."
>
  <Header variant="full" wordmarkAsLink={false} />

  <section class="hero">
    <div class="eyebrow hero__eyebrow">For owner-run businesses</div>
    <h1>Grow the business,<br /> <span class="hero__turn">not just the ad account.</span></h1>

    <div class="hero__row">
      <p class="lead hero__sub">
        I help owner-operated businesses get more out of their marketing, and out of the business behind it. That
        usually starts with the ads and the numbers, and often ends up in follow-up, pricing, and the systems in between.
        Since 2014, I've been doing this for clients and for my own businesses.
      </p>
      <div class="hero__side">
        <div class="hero__actions">
          <CtaLink variant="button-lg" />
          <a href="#proof" class="textlink hero__secondary">See the dashboard</a>
        </div>
        <div class="hero__micro">{CTA_MICROCOPY_HOME}</div>
        <a href="/about" class="hero__byline">
          <span class="hero__avatar"><Portrait crop="circle" size={52} loading="eager" /></span>
          <span>
            <span class="hero__name">Adam Malmborg</span>
            <span class="hero__role">Founder, Project Pineapple. Salt Lake City, clients nationwide.</span>
          </span>
        </a>
      </div>
    </div>

    <figure class="stage">
      <div class="stage__mat">
        <div class="stage__screen">
          <ProductShot
            src={screenMonth}
            frame="window"
            alt="The monthly view of the client dashboard: bookings, ad spend, revenue, return on ads, and where each booking came from, shown with demo data"
            widths={[640, 960, 1280, 1640]}
            sizes="(max-width: 700px) 0px, (max-width: 1240px) 72vw, 900px"
            loading="eager"
          />
        </div>
        <div class="stage__phone">
          <ProductShot
            src={dashboardMobile}
            frame="phone"
            alt="The same dashboard on a phone, with demo data"
            widths={[290, 580, 870]}
            sizes="(max-width: 700px) 62vw, 280px"
            loading="eager"
          />
        </div>
      </div>
      <figcaption>The client dashboard. Demo data.</figcaption>
    </figure>

    <dl class="facts">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    featured && (
      <figure class="quote">
        <blockquote>{featured.quote}</blockquote>
        <figcaption>
          {featured.name}, {featured.business}
        </figcaption>
      </figure>
    )
  }

  <section class="layers">
    <header class="sechead">
      <div>
        <div class="eyebrow sechead__eyebrow">How I help</div>
        <h2 class="display-2">Most of what I do falls into three areas.</h2>
      </div>
      <p class="lead sechead__lead">
        A lot of businesses hire a different person for each of these. I've found it works better when one person can
        see all three, because the problems usually connect.
      </p>
    </header>
    <ol class="areas">
      {
        layers.map((l, i) => (
          <li class="area">
            <div class="area__text">
              <span class="area__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="display-3">{l.heading}</h3>
              <p>{l.body}</p>
            </div>
            <figure class="area__fig">
              <div class:list={['mat', `mat--${l.mat}`, { 'mat--bleed': l.bleed }]}>
                <ProductShot
                  src={l.shot}
                  frame="tile"
                  alt={l.alt}
                  widths={[380, 570, 760]}
                  sizes="(max-width: 860px) 84vw, 590px"
                />
              </div>
              <figcaption>{l.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ol>
  </section>

  <PineList heading="Why growth stalls even when the reports look good" items={problems}>
    Google spends your money toward whatever it can count. If it can't count the sale, it counts something else and
    calls that the result.
  </PineList>

  <section id="how-i-work" class="method">
    <h2 class="display-2">How I work</h2>
    <div class="method__steps"><Steps items={method} /></div>
  </section>

  <section id="proof" class="proof">
    <h2 class="display-2">What this looks like in practice</h2>
    <div class="stories">
      <div class="story">
        <p class="story__lead">A dental practice had been paying an agency for leads for about a year.</p>
        <p class="body body--long">
          The account was optimizing toward form submissions, and form submissions were coming in. When I connected
          the phone and the booking data back to the campaigns, most of those forms had never become appointments.
          The platform had gotten very good at finding people who fill out forms. Rebuilding around booked patients
          changed who the same budget reached, and the practice started seeing the result where it counts, in the
          schedule.
        </p>
      </div>
      <div class="story">
        <p class="story__lead">
          A law firm was bringing in cases from several sources at once: an agency sending leads, directory listings,
          referrals, and their own paid search.
        </p>
        <p class="body body--long">
          Nobody could say which source the good cases came from. Once every source was tracked through to intake,
          one of them clearly wasn't producing, and the firm ended that contract. Their sales cycle is eight months.
          Three months in, I could tell them exactly what had entered the pipeline and where it came from. I could
          not tell them what had closed, because nothing had closed yet. I said so. Most agencies would have reported
          the pipeline number and let it sit there looking like revenue.
        </p>
      </div>
    </div>
    <figure class="proof__shot">
      <div class="proof__pan">
        <ProductShot
          src={dashboardMonth}
          frame="window"
          alt="The monthly view of the client dashboard: spend, bookings, revenue, return on ads, bookings by source with how each is known, and bookings with no source on record, shown with demo data"
          widths={[700, 1000, 1400, 2000]}
          sizes="(max-width: 700px) 940px, (max-width: 1240px) 92vw, 1240px"
        />
      </div>
      <figcaption>
        The monthly view every client gets, shown here with demo data. It shows what you spent, what came back, and
        where each booking came from. Bookings without a clear source are counted separately instead of being guessed.
      </figcaption>
    </figure>
  </section>

  <section class="split terms">
    <div class="split__grid">
      <div class="split__col">
        <h2 class="display-3 terms__h">How I report</h2>
        <p class="body">
          I'll tell you what I know and what I don't. A report that overstates what it knows makes the number look
          good and makes the next decision worse. If your sales cycle is long, I'll be reporting on pipeline before
          I can report on revenue, and I'll say which is which.
        </p>
      </div>
      <div class="split__col">
        <h2 class="display-3 terms__h">How I charge</h2>
        <p class="body">
          A flat monthly fee. Most agencies charge a percentage of your ad spend, which means they earn more when
          you spend more. That is a bad incentive to have sitting between you and the person advising you on your
          budget. My fee is the same whether I tell you to double the spend or cut it in half, so the
          recommendation is just the recommendation.
        </p>
      </div>
    </div>
  </section>

  <section class="operator">
    <div class="operator__portrait">
      <Portrait crop="feature" />
    </div>
    <div class="operator__text">
      <div class="eyebrow">Adam Malmborg</div>
      <p class="operator__lead">Running paid advertising since 2014. Running businesses just as long.</p>
      <p class="body operator__body">
        I've made payroll, set pricing, hired and fired, and watched a marketing invoice land on a P&amp;L I was
        responsible for. That changes how I read an account. Not clicks and impressions, but what it cost to get a
        customer and whether that customer was worth getting.
      </p>
      <p class="operator__quote">You work with me, not an account team.</p>
      <a href="/about" class="textlink operator__link">More about me</a>
    </div>
  </section>

  <section class="engagement">
    <h2 class="display-2">What working together looks like</h2>
    <div class="engagement__grid">
      {
        engagements.map((e) => (
          <div class="plan">
            <div class="eyebrow plan__label">{e.label}</div>
            <h3 class="display-3 plan__name">{e.name}</h3>
            <p class="body plan__intro">{e.intro}</p>
            <ul class="plan__list">
              {e.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="pull engagement__pull">
      You don't have to figure out which one you need before we talk. The assessment usually makes it obvious.
    </p>
  </section>

  <section id="who-its-for" class="section--pine fit">
    <h2 class="display-2">Who this is for</h2>
    <div class="fit__text">
      <p class="fit__p1">
        Businesses doing between $500,000 and $10 million in revenue, spending at least $3,000 a month on media,
        where the sale happens on a phone call, in a showroom, or across a few weeks of consideration. Home services
        and the trades, med spas, dental and medical practices, law firms, custom retail.
      </p>
      <p class="fit__p2">
        It's a poor fit for pure ecommerce, where the platform already sees the transaction, and for high-volume
        low-ticket businesses where there isn't much to attribute.
      </p>
      <p class="fit__p3">Based in Salt Lake City, working with clients anywhere in the country.</p>
    </div>
  </section>

  <ClosingCta heading="Start with the assessment">
    Thirty minutes on where your growth is coming from, where it's leaking, and the two or three changes that would
    move the most. You keep the findings either way.
  </ClosingCta>

  <Footer />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: var(--pad-hero) var(--gutter) clamp(40px, 5vw, 72px);
    border-bottom: 1px solid var(--hairline);
  }
  .hero__eyebrow {
    margin-bottom: clamp(20px, 2.4vw, 32px);
  }
  .hero h1 {
    margin: 0 0 clamp(28px, 3.6vw, 52px);
    font: 400 clamp(46px, 7.6vw, 108px) / 0.98 var(--display);
    letter-spacing: -0.026em;
    text-wrap: balance;
  }
  .hero__turn {
    color: var(--clay);
  }
  .hero__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: clamp(28px, 4vw, 96px);
    align-items: start;
  }
  .hero__sub {
    max-width: 54ch;
  }
  .hero__side {
    justify-self: start;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
  }
  .hero__secondary {
    font: 500 15.5px/1 var(--sans);
  }
  .hero__micro {
    margin: 18px 0 0;
    font: 400 13.5px/1.6 var(--sans);
    color: var(--text-60);
    max-width: 44ch;
  }
  .hero__byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--hairline-inner);
    text-decoration: none;
    color: var(--pine);
  }
  .hero__byline:hover .hero__name {
    color: var(--clay);
  }
  .hero__avatar {
    width: 52px;
    flex: none;
  }
  .hero__name {
    display: block;
    font: 500 15px/1.3 var(--sans);
  }
  .hero__role {
    display: block;
    font: 400 13.5px/1.5 var(--sans);
    color: var(--text-60);
  }

  /* The product, on a pine mat. The screen bleeds off the bottom edge and the
     phone stands in front of it. */
  .stage {
    margin: clamp(40px, 5.6vw, 84px) 0 0;
  }
  .stage__mat {
    position: relative;
    overflow: hidden;
    background: var(--pine);
    height: clamp(380px, 46vw, 610px);
    padding: clamp(22px, 4.4vw, 60px) clamp(22px, 4.4vw, 60px) 0;
  }
  .stage__screen {
    width: 77%;
  }
  .stage__phone {
    position: absolute;
    right: clamp(22px, 4.4vw, 60px);
    top: 17%;
    width: 23%;
  }
  .stage figcaption,
  .area__fig figcaption,
  .proof__shot figcaption {
    margin-top: 14px;
    font: 400 13px/1.6 var(--sans);
    color: var(--text-60);
  }
  @media (max-width: 700px) {
    .stage__screen {
      display: none;
    }
    .stage__phone {
      position: static;
      width: min(66%, 270px);
      margin: 0 auto;
    }
  }

  .facts {
    margin: clamp(36px, 4.6vw, 64px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 0 clamp(24px, 3vw, 48px);
  }
  .facts > div {
    padding: 18px 0 20px;
    border-top: 1px solid var(--pine);
  }
  .facts dt {
    font: 500 11.5px/1 var(--sans);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-60);
    margin-bottom: 14px;
  }
  .facts dd {
    margin: 0;
    font: 400 clamp(28px, 3.3vw, 44px) / 1 var(--display);
    letter-spacing: -0.015em;
  }

  /* Client quote, only rendered when testimonials.ts has an approved entry */
  .quote {
    margin: 0;
    padding: var(--pad-secondary) var(--gutter);
    border-bottom: 1px solid var(--hairline);
    background: var(--cream-2);
  }
  .quote blockquote {
    margin: 0 0 22px;
    max-width: 30ch;
    font: 400 clamp(24px, 3.3vw, 44px) / 1.18 var(--display);
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .quote figcaption {
    font: 400 14px/1.5 var(--sans);
    color: var(--text-65);
  }

  /* ---------- Shared section header: title left, lead right ---------- */
  .sechead {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: clamp(20px, 4vw, 96px);
    align-items: end;
  }
  .sechead__eyebrow {
    margin-bottom: clamp(16px, 1.8vw, 24px);
  }
  .sechead h2 {
    max-width: 14ch;
  }
  .sechead__lead {
    max-width: 46ch;
    padding-bottom: 0.4em;
  }

  /* ---------- How I help: three areas, each beside a piece of the product ---------- */
  .layers {
    padding: var(--pad-major) var(--gutter);
    border-bottom: 1px solid var(--hairline);
  }
  .areas {
    list-style: none;
    margin: clamp(48px, 6.6vw, 96px) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(48px, 6.6vw, 96px);
  }
  .area {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(26px, 5.6vw, 96px);
    align-items: center;
    padding-top: clamp(48px, 6.6vw, 96px);
    border-top: 1px solid var(--hairline);
  }
  .area:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .area__num {
    display: block;
    font: 400 clamp(17px, 1.5vw, 20px) / 1 var(--display);
    letter-spacing: 0.04em;
    color: var(--clay);
    margin-bottom: clamp(16px, 2vw, 28px);
  }
  .area__text h3 {
    margin: 0 0 clamp(14px, 1.6vw, 22px);
    font-size: clamp(28px, 3.6vw, 50px);
    line-height: 1.06;
    letter-spacing: -0.018em;
    max-width: 12ch;
  }
  .area__text p {
    font: 400 clamp(16.5px, 1.4vw, 18.5px) / 1.65 var(--sans);
    color: var(--text-82);
    max-width: 38ch;
  }
  .area__fig {
    margin: 0;
  }
  .mat {
    padding: clamp(18px, 3.6vw, 48px);
  }
  .mat--sand {
    background: var(--sand);
  }
  .mat--pine {
    background: var(--pine);
  }
  .mat :global(.shot) {
    border: 1px solid var(--hairline);
  }
  .mat--bleed {
    padding-bottom: 0;
  }
  .mat--bleed :global(.shot) {
    border-bottom: 0;
  }
  .area:nth-child(even) {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .area:nth-child(even) .area__text {
    order: 2;
  }
  @media (max-width: 860px) {
    .area,
    .area:nth-child(even) {
      grid-template-columns: 1fr;
    }
    .area:nth-child(even) .area__text {
      order: 0;
    }
  }

  /* ---------- Method: four steps across ---------- */
  .method {
    padding: var(--pad-major) var(--gutter);
    border-bottom: 1px solid var(--hairline);
  }
  .method__steps {
    margin-top: clamp(36px, 5vw, 72px);
  }

  /* ---------- Proof ---------- */
  .proof {
    padding: var(--pad-major) var(--gutter);
    background: var(--cream-2);
    border-bottom: 1px solid var(--hairline);
  }
  .proof h2 {
    max-width: 22ch;
  }
  .stories {
    margin-top: clamp(36px, 5vw, 72px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(36px, 4vw, 72px);
  }
  /* Each story spans two shared rows, so the two bodies start level even
     though the opening sentences differ in length. */
  .story {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
    row-gap: 18px;
    border-top: 1px solid var(--pine);
    padding-top: clamp(20px, 2.2vw, 28px);
  }
  .story__lead {
    font: 400 clamp(20px, 1.9vw, 25px) / 1.34 var(--serif);
    max-width: 30ch;
  }
  @media (max-width: 760px) {
    .stories {
      grid-template-columns: 1fr;
    }
    .story + .story {
      margin-top: 36px;
    }
  }
  .story .body {
    max-width: 56ch;
  }
  .proof__shot {
    margin: clamp(44px, 5.6vw, 88px) 0 0;
  }
  .proof__shot figcaption {
    max-width: 78ch;
  }
  /* On a phone the full dashboard would shrink to a thumbnail. Keep it at a
     readable size and let it pan sideways instead. */
  @media (max-width: 700px) {
    .proof__pan {
      overflow-x: auto;
      margin-right: calc(var(--gutter) * -1);
      -webkit-overflow-scrolling: touch;
    }
    .proof__pan :global(.shot) {
      width: 940px;
    }
  }

  /* ---------- How I report / How I charge ---------- */
  .terms {
    border-bottom: 1px solid var(--hairline);
  }
  .terms .split__col {
    padding-top: var(--pad-secondary);
    padding-bottom: var(--pad-secondary);
  }
  .terms__h {
    margin-bottom: clamp(16px, 1.8vw, 24px);
  }
  .terms .body {
    max-width: 50ch;
  }

  /* ---------- Operator ---------- */
  .operator {
    padding: var(--pad-major) var(--gutter);
    background: var(--sand);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 5.6vw, 104px);
    align-items: center;
  }
  .operator__portrait {
