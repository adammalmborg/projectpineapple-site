---
/**
 * Industry landing page template. Driven entirely by src/content/industries.ts.
 * Paid-search landing page first: wordmark-only header, no nav, one CTA top
 * and bottom, no testimonial.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaLink from '../components/CtaLink.astro';
import PineList from '../components/PineList.astro';
import Steps from '../components/Steps.astro';
import StatStrip from '../components/StatStrip.astro';
import OperatorBlock from '../components/OperatorBlock.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { industries } from '../content/industries';
import { CTA_MICROCOPY_INDUSTRY } from '../content/site';

export function getStaticPaths() {
  return Object.values(industries).map((industry) => ({
    params: { industry: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
---

<Base title={industry.title} description={industry.description}>
  <Header variant="wordmark" />

  <section class="hero">
    <div class="eyebrow hero__eyebrow">{industry.eyebrow}</div>
    <h1>{industry.headline}</h1>
    <p class="lead hero__sub">{industry.subhead}</p>
    <div class="hero__cta">
      <CtaLink variant="button-lg" />
      <span class="hero__micro">{CTA_MICROCOPY_INDUSTRY}</span>
    </div>
  </section>

  <PineList heading={industry.breaksHeading} items={industry.breaks} />

  <section class="method">
    <h2 class="display-2">{industry.methodHeading}</h2>
    <div class="method__steps"><Steps items={industry.method} /></div>
  </section>

  <StatStrip items={industry.stats} size="md" />

  <OperatorBlock heading="Adam Malmborg, Project Pineapple">
    Running paid advertising since 2014. Running businesses just as long. You work with me, not an account team.
  </OperatorBlock>

  <ClosingCta heading={industry.closingHeading} variant="industry">
    {industry.closingBody}
  </ClosingCta>

  <Footer />
</Base>

<style>
  .hero {
    padding: var(--pad-hero) var(--gutter) var(--pad-major);
    border-bottom: 1px solid var(--hairline);
  }
  .hero__eyebrow {
    margin-bottom: clamp(20px, 2.4vw, 32px);
  }
  .hero h1 {
    margin: 0 0 clamp(24px, 3vw, 40px);
    font: 400 clamp(36px, 5.6vw, 78px) / 1.02 var(--display);
    letter-spacing: -0.024em;
    text-wrap: balance;
    max-width: 21ch;
  }
  .hero__sub {
    margin: 0 0 clamp(28px, 3vw, 40px);
    max-width: 58ch;
  }
  .hero__cta {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .hero__micro {
    font: 400 13.5px/1.6 var(--sans);
    color: var(--text-60);
    max-width: 26ch;
  }

  .method {
    padding: var(--pad-major) var(--gutter);
    border-bottom: 1px solid var(--hairline);
  }
  .method h2 {
    max-width: 18ch;
  }
  .method__steps {
    margin-top: clamp(36px, 5vw, 72px);
  }
</style>
