---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaLink from '../components/CtaLink.astro';
import { CITY, EMAIL, LEGAL_NAME } from '../content/site';
---

<Base
  title="Contact | Project Pineapple"
  description="Email Adam Malmborg at Project Pineapple, or book the free thirty-minute marketing assessment. Salt Lake City, clients nationwide."
>
  <Header variant="full" />

  <section class="contact">
    <div>
      <h1>Contact</h1>
      <address class="details">
        <span>{LEGAL_NAME}</span>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <span>{CITY}</span>
      </address>
    </div>
    <div class="panel">
      <p class="panel__lead">The fastest way to start is the assessment.</p>
      <CtaLink class="panel__btn" />
    </div>
  </section>

  <Footer />
</Base>

<style>
  .contact {
    padding: var(--pad-hero) var(--gutter) var(--pad-major);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: clamp(28px, 4.7vw, 56px);
    border-bottom: 1px solid var(--hairline);
  }
  h1 {
    margin: 0 0 32px;
    font: 400 clamp(34px, 4.8vw, 64px) / 1.04 var(--display);
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .details {
    display: grid;
    gap: 14px;
    font: 400 17px/1.6 var(--sans);
    font-style: normal;
    color: var(--text-82);
  }
  .details a {
    color: var(--pine);
    text-decoration: none;
    border-bottom: 1px solid var(--middot);
    padding-bottom: 2px;
    justify-self: start;
    font: 400 clamp(21px, 2.3vw, 30px) / 1.3 var(--display);
  }
  .details a:hover {
    color: var(--clay);
  }

  .panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 22px;
    background: var(--sand);
    padding: clamp(28px, 4vw, 56px);
    min-height: clamp(220px, 24vw, 320px);
  }
  .panel__lead {
    max-width: 26ch;
    font: 400 clamp(24px, 2.8vw, 36px) / 1.14 var(--display);
    letter-spacing: -0.012em;
  }
  .panel :global(.panel__btn) {
    padding: 15px 30px;
  }
</style>
