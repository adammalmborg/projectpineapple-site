---
/**
 * Base document. Every route uses this.
 *
 * Responsibilities: fonts (self-hosted via fontsource), global styles, SEO
 * metadata, canonical and Open Graph tags, and the Cal.com loader so that
 * every element carrying data-cal-link opens the booking modal.
 */
import '@fontsource/libre-caslon-display/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '../styles/global.css';

import { CAL_NAMESPACE, CF_ANALYTICS_TOKEN, GTM_ID, SITE_NAME } from '../content/site';

interface Props {
  title: string;
  description: string;
  /** Post-conversion pages should not be indexed. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// The picture shown when a link to the site is shared in a message or post.
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Project Pineapple. Grow the business, not just the ad account." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf5ee" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- dataLayer exists on every page so events can be pushed whether or
         not a tag manager is configured. gtag() is defined for any tag or
         consent command that expects it. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
    </script>
    {
      GTM_ID && (
        <script is:inline define:vars={{ GTM_ID }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', GTM_ID);
        </script>
      )
    }

    <!-- Cal.com embed loader. Binds every [data-cal-link] on the page by
         delegation and exposes Cal.ns[namespace] for the inline embed. -->
    <script is:inline define:vars={{ ns: CAL_NAMESPACE }}>
      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');
      Cal('init', ns, { origin: 'https://app.cal.com' });
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;
      Cal.ns[ns]('ui', {
        theme: 'light',
        hideEventTypeDetails: false,
        layout: 'month_view',
        cssVarsPerTheme: {
          light: { 'cal-brand': '#22402f' },
          dark: { 'cal-brand': '#22402f' },
        },
      });
      // Where the visitor came from, for the booking. forwardQueryParams only
      // forwards the query string of the page the booking is made on, so a
      // visitor who lands on one page with ?utm_source=...&gclid=... and books
      // from another would arrive at Cal.com with no source. The capture tag
      // (GTM) keeps first and last touch under "_pineapple" (cookie, mirrored
      // in localStorage: URI-encoded JSON { first: { params }, last: { params } });
      // this reads it (last touch wins per key, first touch fills gaps, the
      // current page's own query string on top) and returns only the eight
      // keys the intro event type has hidden booking questions for. No
      // identifier is read or sent: these are campaign tags and click ids.
      var SOURCE_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'msclkid'];
      window.__bookingSource = function () {
        var out = {};
        var state = null;
        try {
          var text = null;
          var m = document.cookie.match(/(?:^|;\s*)_pineapple=([^;]*)/);
          if (m) text = m[1];
          if (!text && window.localStorage) text = window.localStorage.getItem('_pineapple');
          if (text) state = JSON.parse(decodeURIComponent(text));
        } catch (e) {
          state = null;
        }
        var first = (state && state.first && state.first.params) || {};
        var last = (state && state.last && state.last.params) || {};
        var here = {};
        try {
          new URLSearchParams(location.search).forEach(function (v, k) {
            here[k] = v;
          });
        } catch (e) {}
        SOURCE_KEYS.forEach(function (k) {
          var v = here[k] || last[k] || first[k];
          if (typeof v === 'string' && v && v.length <= 300) out[k] = v;
        });
        return out;
      };
      // CTA clicks. Every booking link carries data-cal-link; record which one
      // was clicked and where on the page it sits, before the modal opens, and
      // hand the stored source to the modal (Cal.com reads data-cal-config at
      // click time and prefills a booking question whose identifier matches).
      document.addEventListener(
        'click',
        function (ev) {
          var a = ev.target && ev.target.closest && ev.target.closest('a[data-cal-link]');
          if (!a) return;
          try {
            var cfg = JSON.parse(a.getAttribute('data-cal-config') || '{}') || {};
            var src = window.__bookingSource();
            for (var k in src) cfg[k] = src[k];
            a.setAttribute('data-cal-config', JSON.stringify(cfg));
          } catch (e) {}
          var section = a.closest('section, header, footer');
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'cta_click',
            cta_text: (a.textContent || '').trim(),
            cta_location: section ? (section.id || section.className || section.tagName.toLowerCase()) : 'unknown',
            page_path: location.pathname,
          });
        },
        true
      );
      // Conversion event. Fires for both the modal and the inline embed.
      Cal.ns[ns]('on', {
        action: 'bookingSuccessful',
        callback: function (e) {
          var d = (e && e.detail && e.detail.data) || {};
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'booking_complete',
            booking_event_type: (d.eventType && d.eventType.slug) || ns,
          });
        },
      });
    </script>
  </head>
  <body>
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <main class="page">
      <slot />
    </main>
    {
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </body>
</html>
