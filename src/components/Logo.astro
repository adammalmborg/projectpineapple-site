---
/**
 * Logo mark: a pineapple with a clay crown and a pine body. Vector redraw of
 * the original sketch, from the design pass, recolored to the site palette.
 * The solid body is used at header and favicon sizes, where the lattice
 * turns to noise. The 120x272 viewBox is a tight crop around the drawing.
 */
interface Props {
  height?: number;
}
const { height = 28 } = Astro.props;
const width = Math.round((height * 120) / 272 * 10) / 10;
---

<svg
  width={width}
  height={height}
  viewBox="40 -8 120 272"
  aria-hidden="true"
  focusable="false"
><Fragment set:html={`<clipPath id="pp-mark-crown" clip-rule="evenodd"><path clip-rule="evenodd" fill-rule="evenodd" d="M-50,-50H250V310H-50Z M44,162a50,50 0 0 1 50,-50h12a50,50 0 0 1 50,50v48a50,50 0 0 1 -50,50h-12a50,50 0 0 1 -50,-50Z"/></clipPath><g fill="#c1613c" clip-path="url(#pp-mark-crown)"><path d="M-15.00,0 C-15.75,-52.92 -8.25,-100.80 0,-126.00 C8.25,-100.80 15.75,-52.92 15.00,0 Z" transform="translate(100,122) rotate(0)"/><path d="M-14.00,0 C-14.70,-47.04 -7.70,-89.60 0,-112.00 C7.70,-89.60 14.70,-47.04 14.00,0 Z" transform="translate(100,122) rotate(-15)"/><path d="M-14.00,0 C-14.70,-47.04 -7.70,-89.60 0,-112.00 C7.70,-89.60 14.70,-47.04 14.00,0 Z" transform="translate(100,122) rotate(15)"/><path d="M-13.00,0 C-13.65,-38.64 -7.15,-73.60 0,-92.00 C7.15,-73.60 13.65,-38.64 13.00,0 Z" transform="translate(100,122) rotate(-32)"/><path d="M-13.00,0 C-13.65,-38.64 -7.15,-73.60 0,-92.00 C7.15,-73.60 13.65,-38.64 13.00,0 Z" transform="translate(100,122) rotate(32)"/><path d="M-11.00,0 C-11.55,-27.72 -6.05,-52.80 0,-66.00 C6.05,-52.80 11.55,-27.72 11.00,0 Z" transform="translate(100,122) rotate(-50)"/><path d="M-11.00,0 C-11.55,-27.72 -6.05,-52.80 0,-66.00 C6.05,-52.80 11.55,-27.72 11.00,0 Z" transform="translate(100,122) rotate(50)"/></g><rect x="44" y="112" width="112" height="148" rx="50" fill="#22402f"/>`} /></svg>

<style>
  svg {
    flex: none;
    display: block;
  }
</style>
