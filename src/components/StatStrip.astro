---
/**
 * Three equal columns on a sand band with vertical dividers. The band is
 * full-bleed; the cells sit inside the page gutter. When the cells wrap, a
 * container query stacks them and swaps the dividers to horizontal.
 */
interface Props {
  items: { label: string; value: string }[];
  /** Home uses a 22px value; industry pages use 21px. */
  size?: 'lg' | 'md';
}

const { items, size = 'lg' } = Astro.props;
---

<div class="strip-wrap">
  <dl class:list={['strip', { 'strip--md': size === 'md' }]}>
    {
      items.map(({ label, value }) => (
        <div class="cell">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .strip-wrap {
    container-type: inline-size;
    padding: 0 var(--gutter);
    background: var(--sand);
    border-bottom: 1px solid var(--hairline);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 165px), 1fr));
    margin: 0;
  }
  .cell {
    padding: clamp(22px, 2.6vw, 34px) clamp(18px, 2.4vw, 32px);
    border-right: 1px solid var(--hairline-inner);
  }
  .cell:first-child {
    padding-left: 0;
  }
  .cell:last-child {
    padding-right: 0;
    border-right: 0;
  }
  dt {
    font: 500 11px/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  dd {
    margin: 0;
    font: 400 clamp(17px, 2.3vw, 30px) / 1.05 var(--display);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .strip--md dd {
    font-size: clamp(17px, 2.1vw, 27px);
  }

  @container (width < 520px) {
    .strip {
      grid-template-columns: 1fr;
    }
    .cell,
    .cell:first-child,
    .cell:last-child {
      padding-left: 0;
      padding-right: 0;
      border-right: 0;
    }
    .cell + .cell {
      border-top: 1px solid var(--hairline-inner);
    }
  }
</style>
