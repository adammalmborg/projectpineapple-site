---
/**
 * Three summary cards, the same pattern as the app's KPI row. Cards wrap to
 * a single column when there isn't room for three.
 */
interface Props {
  items: { label: string; value: string }[];
  /** Home uses a 22px value; industry pages use 21px. */
  size?: 'lg' | 'md';
}

const { items, size = 'lg' } = Astro.props;
---

<div class="strip-wrap">
  <dl class:list={['strip', { 'strip--md': size === 'md' }]}>
    {
      items.map(({ label, value }) => (
        <div class="cell">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  /* KPI cards, matching the app's summary row */
  .strip-wrap {
    container-type: inline-size;
    padding: clamp(20px, 2.7vw, 30px) var(--gutter);
    border-bottom: 1px solid var(--hairline);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 165px), 1fr));
    gap: 14px;
    margin: 0;
  }
  .cell {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    padding: 18px 22px 20px;
  }
  dt {
    font: 500 13px/1.3 var(--sans);
    color: var(--text-65);
    margin-bottom: 8px;
  }
  dd {
    margin: 0;
    font: 700 clamp(18px, 1.86vw, 24px) / 1.1 var(--display);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .strip--md dd {
    font-size: clamp(18px, 1.78vw, 23px);
  }
</style>
