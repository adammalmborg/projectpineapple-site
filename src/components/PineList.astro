---
/**
 * A pine band that makes an argument: the heading (and an optional intro in
 * the default slot) on the left, a ruled list of points on the right. On a
 * wide screen the heading stays in view while the list scrolls past it.
 */
interface Props {
  heading: string;
  items: { heading: string; body: string }[];
}

const { heading, items } = Astro.props;
const hasIntro = Astro.slots.has('default');
---

<section class="section--pine band">
  <div class="band__head">
    <h2 class="display-2">{heading}</h2>
    {hasIntro && <p class="lead band__intro"><slot /></p>}
  </div>
  <ul class="band__list">
    {
      items.map((item) => (
        <li>
          <span class="diamond" aria-hidden="true" />
          <div>
            <div class="band__heading">{item.heading}</div>
            <div class="band__body">{item.body}</div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .band {
    padding: var(--pad-major) var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: clamp(36px, 5.6vw, 104px);
    align-items: start;
  }
  .band__head h2 {
    max-width: 13ch;
  }
  .band__intro {
    margin-top: clamp(20px, 2.4vw, 32px);
    color: var(--on-pine-2);
    max-width: 40ch;
  }
  .band__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .band__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(16px, 2vw, 26px);
    padding: clamp(22px, 2.6vw, 34px) 0;
    border-top: 1px solid var(--hairline-on-pine);
  }
  .band__list li:last-child {
    border-bottom: 1px solid var(--hairline-on-pine);
  }
  .band__list .diamond {
    margin-top: 0.75em;
  }
  .band__heading {
    font: 400 clamp(21px, 2.3vw, 31px) / 1.16 var(--display);
    letter-spacing: -0.008em;
    margin-bottom: 8px;
    text-wrap: balance;
  }
  .band__body {
    font: 400 16.5px/1.6 var(--sans);
    color: var(--on-pine-2);
    max-width: 52ch;
  }
  @media (min-width: 861px) {
    .band__head {
      position: sticky;
      top: calc(var(--header-h) + 48px);
    }
  }
</style>
