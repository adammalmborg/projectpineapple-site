---
import { CITY, LEGAL_NAME } from '../content/site';
---

<footer class="footer">
  <span>{LEGAL_NAME}</span>
  <span class="dot" aria-hidden="true">·</span>
  <span>{CITY}</span>
  <span class="dot" aria-hidden="true">·</span>
  <a href="/contact">Contact</a>
  <span class="dot" aria-hidden="true">·</span>
  <a href="/terms">Terms</a>
</footer>

<style>
  .footer {
    padding: 26px var(--gutter);
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font: 400 12.5px/1 var(--sans);
    color: var(--muted);
  }
  .dot {
    color: var(--middot);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--pine);
  }
</style>
