---
import { CITY, LEGAL_NAME } from '../content/site';
---

<footer class="footer">
  <div class="footer__brand">Project Pineapple</div>
  <nav class="footer__links" aria-label="Footer">
    <a href="/contact">Contact</a>
    <a href="/terms">Terms</a>
    <a href="/privacy">Privacy</a>
  </nav>
  <div class="footer__legal">
    <span>{LEGAL_NAME}</span>
    <span class="dot" aria-hidden="true">·</span>
    <span>{CITY}</span>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(36px, 4.4vw, 56px) var(--gutter) clamp(30px, 3.4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 18px 32px;
    align-items: baseline;
    font: 400 13.5px/1.4 var(--sans);
    color: var(--text-65);
  }
  .footer__brand {
    font: 400 15px/1 var(--serif);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--pine);
  }
  .footer__links {
    display: flex;
    gap: clamp(18px, 2.4vw, 32px);
  }
  .footer__legal {
    flex-basis: 100%;
    padding-top: 20px;
    border-top: 1px solid var(--hairline-inner);
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 12.5px;
    color: var(--muted);
  }
  .dot {
    color: var(--middot);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--clay);
  }
</style>
