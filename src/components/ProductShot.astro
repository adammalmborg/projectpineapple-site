---
/**
 * A screen from the client dashboard app. These are real product screens
 * populated with demo data ("Example Home Co."), and every caption that uses
 * them must say so. Never present them as a real client's results.
 *
 * Two frames: a phone, drawn as a pine bezel (the one rounded shape on the
 * site besides portraits, because it depicts a device), and a plain screen
 * with a hairline border and square corners.
 *
 * Astro generates responsive WebP derivatives at build time.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  frame: 'phone' | 'screen';
  /** CSS sizes attribute for responsive selection. */
  sizes: string;
  widths: number[];
  loading?: 'lazy' | 'eager';
}

const { src, alt, frame, sizes, widths, loading = 'lazy' } = Astro.props;
---

<div class:list={['shot', `shot--${frame}`]}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" />
</div>

<style>
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot--phone {
    background: var(--pine);
    border-radius: 30px;
    padding: 8px;
  }
  .shot--phone img {
    border-radius: 23px;
  }
  .shot--screen {
    border: 1px solid var(--hairline);
    background: var(--cream);
  }
</style>
