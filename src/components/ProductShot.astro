---
/**
 * A screen from the client dashboard app, framed as a phone or a browser
 * window. These are real product screens populated with demo data
 * ("Example Home Co."), and every caption that uses them must say so.
 *
 * Astro generates responsive WebP derivatives at build time.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  frame: 'phone' | 'browser';
  /** CSS sizes attribute for responsive selection. */
  sizes: string;
  widths: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, alt, frame, sizes, widths, loading = 'lazy', class: className = '' } = Astro.props;
---

<div class:list={['shot', `shot--${frame}`, className]}>
  {
    frame === 'browser' && (
      <div class="shot__bar" aria-hidden="true">
        <span />
        <span />
        <span />
      </div>
    )
  }
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" />
</div>

<style>
  .shot {
    background: var(--card);
    border: 1px solid var(--card-border);
    overflow: hidden;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot--phone {
    border-radius: 28px;
    padding: 8px;
    background: var(--ink);
    border-color: var(--ink);
  }
  .shot--phone img {
    border-radius: 21px;
  }
  .shot--browser {
    border-radius: var(--radius-lg);
  }
  .shot__bar {
    display: flex;
    gap: 6px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--card-border);
    background: var(--cream-2);
  }
  .shot__bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(21, 32, 43, 0.16);
  }
</style>
