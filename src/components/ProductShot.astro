---
/**
 * A screen from the client dashboard app. These are real product screens
 * populated with demo data ("Example Home Co."), and every caption that uses
 * them must say so. Never present them as a real client's results.
 *
 * Frames:
 *   phone   a dark bezel (the one rounded shape on the site besides
 *           portraits, because it depicts a device)
 *   screen  a plain hairline border, square corners
 *   window  a browser window: a slim title bar above the screen
 *   tile    a borderless crop, for a single card lifted out of a screen
 *
 * Astro generates responsive WebP derivatives at build time.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  frame: 'phone' | 'screen' | 'window' | 'tile';
  /** CSS sizes attribute for responsive selection. */
  sizes: string;
  widths: number[];
  loading?: 'lazy' | 'eager';
}

const { src, alt, frame, sizes, widths, loading = 'lazy' } = Astro.props;
---

<div class:list={['shot', `shot--${frame}`]}>
  {
    frame === 'window' && (
      <div class="shot__bar" aria-hidden="true">
        <span />
        <span />
        <span />
      </div>
    )
  }
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" />
</div>

<style>
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot--phone {
    background: #14271c;
    border-radius: 12% / 6.4%;
    padding: 3.2%;
    border: 1px solid rgba(250, 245, 238, 0.22);
  }
  .shot--phone img {
    border-radius: 9.5% / 5.2%;
  }
  .shot--window {
    background: var(--cream);
    border: 1px solid var(--hairline);
  }
  .shot__bar {
    display: flex;
    gap: 6px;
    padding: 11px 14px;
    background: var(--sand);
    border-bottom: 1px solid var(--hairline-inner);
  }
  .shot__bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(34, 64, 47, 0.22);
  }
  .shot--tile {
    background: var(--cream);
  }
  .shot--screen {
    border: 1px solid var(--hairline);
    background: var(--cream);
  }
</style>
