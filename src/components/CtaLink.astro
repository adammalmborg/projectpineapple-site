---
/**
 * The site's one call to action, in every place it appears.
 *
 * Renders an anchor that Cal.com binds by delegation (data-cal-link) to open
 * the booking modal. The href points at /assessment as the no-JS fallback,
 * which is also where the inline embed lives.
 *
 * `variant`:
 *   button     solid pine button (default)
 *   button-lg  the larger hero and closing button
 *   button-sm  the compact header button
 *   on-pine    large cream button for pine bands
 *   text       hairline-underlined text link (mobile menu)
 */
import { CAL_CONFIG, CAL_LINK, CAL_NAMESPACE, CTA_LABEL } from '../content/site';

interface Props {
  variant?: 'button' | 'button-lg' | 'button-sm' | 'on-pine' | 'text';
  class?: string;
}

const { variant = 'button', class: className = '' } = Astro.props;

const base = {
  text: 'textlink',
  'button-lg': 'btn btn--lg',
  'button-sm': 'btn btn--sm',
  'on-pine': 'btn btn--lg btn--on-pine',
  button: 'btn',
}[variant];
const cls = `${base} ${className}`;
---

<a
  href="/assessment"
  class={cls.trim()}
  data-cal-link={CAL_LINK}
  data-cal-namespace={CAL_NAMESPACE}
  data-cal-config={JSON.stringify(CAL_CONFIG)}
>
  {CTA_LABEL}
</a>
