---
/**
 * Closing call to action: a sand band, one large centered heading, one
 * paragraph, the button.
 */
import CtaLink from './CtaLink.astro';

interface Props {
  heading: string;
  /** Kept for the call sites; both variants now share one layout. */
  variant?: 'home' | 'industry';
}

const { heading } = Astro.props;
---

<section class="closing">
  <h2 class="display-1">{heading}</h2>
  <p class="lead"><slot /></p>
  <CtaLink variant="button-lg" />
</section>

<style>
  .closing {
    padding: var(--pad-major) var(--gutter);
    text-align: center;
    background: var(--sand);
    border-bottom: 1px solid var(--hairline);
  }
  h2 {
    margin: 0 auto clamp(18px, 2vw, 26px);
    max-width: 18ch;
  }
  p {
    margin: 0 auto clamp(28px, 3vw, 40px);
    max-width: 50ch;
  }
</style>
