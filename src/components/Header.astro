---
/**
 * Site header. Three variants per the handoff:
 *
 *   full      Home: How I work, Who it's for, About, CTA
 *   minimal   Assessment (section links, no CTA since the embed is on the page),
 *             About, Contact, Terms (CTA only)
 *   wordmark  Dental, Legal, Thanks: no nav at all, to protect the single
 *             conversion path on landing pages
 *
 * The header is sticky, so the booking button stays in reach the whole way
 * down the page.
 *
 * Mobile navigation: below 720px the inline nav is replaced by a native
 * <details> disclosure. No JavaScript, no animation, keyboard accessible.
 */
import Logo from './Logo.astro';
import CtaLink from './CtaLink.astro';

type Variant = 'full' | 'minimal' | 'wordmark';

interface Props {
  variant?: Variant;
  /** For 'minimal': show section links (How I work, Who it's for, About). */
  sectionLinks?: boolean;
  /** For 'minimal': show the CTA text link. */
  cta?: boolean;
  /** Home renders the wordmark as plain text (already on the page). */
  wordmarkAsLink?: boolean;
}

const {
  variant = 'full',
  sectionLinks = variant === 'full',
  cta = variant === 'full',
  wordmarkAsLink = true,
} = Astro.props;

const hasNav = variant !== 'wordmark' && (sectionLinks || cta);
---

<header class="header">
  <div class="lockup">
    <Logo />
    {
      wordmarkAsLink ? (
        <a href="/" class="wordmark">Project Pineapple</a>
      ) : (
        <span class="wordmark">Project Pineapple</span>
      )
    }
  </div>

  {
    hasNav && (
      <>
        <nav class="nav nav--inline" aria-label="Primary">
          {sectionLinks && (
            <>
              <a href="/#how-i-work">How I work</a>
              <a href="/#who-its-for">Who it's for</a>
              <a href="/about">About</a>
            </>
          )}
          {cta && <CtaLink variant="button-sm" />}
        </nav>

        <details class="nav nav--mobile">
          <summary>
            Menu
          </summary>
          <nav aria-label="Primary">
            {sectionLinks && (
              <>
                <a href="/#how-i-work">How I work</a>
                <a href="/#who-its-for">Who it's for</a>
                <a href="/about">About</a>
              </>
            )}
            {cta && <CtaLink variant="text" />}
          </nav>
        </details>
      </>
    )
  }
</header>

<script>
  // Close the mobile menu after a link in it is used, so an in-page jump
  // doesn't land underneath an open menu.
  const menu = document.querySelector<HTMLDetailsElement>('details.nav--mobile');
  menu?.addEventListener('click', (ev) => {
    if ((ev.target as HTMLElement).closest('a')) menu.open = false;
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 28px;
    min-height: var(--header-h);
    padding: 14px var(--gutter);
    background: rgba(250, 245, 238, 0.9);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--hairline);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }
  .wordmark {
    font: 400 15px/1 var(--serif);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--pine);
    text-decoration: none;
  }
  a.wordmark:hover {
    color: var(--pine);
  }

  .nav--inline {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.6vw, 36px);
    font: 400 14px/1 var(--sans);
    color: var(--text-72);
  }
  .nav--inline a:not(.btn) {
    color: inherit;
    text-decoration: none;
    padding: 6px 0;
  }
  .nav--inline a:not(.btn):hover {
    color: var(--clay);
  }
  .nav--inline :global(.btn) {
    margin-left: 4px;
  }

  /* Mobile disclosure, hidden on wider screens */
  .nav--mobile {
    display: none;
    font: 400 14px/1 var(--sans);
  }
  .nav--mobile summary {
    list-style: none;
    cursor: pointer;
    color: var(--pine);
    padding: 10px 0 10px 14px;
    user-select: none;
  }
  .nav--mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav--mobile summary::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 8px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }
  .nav--mobile[open] summary::after {
    transform: translateY(1px) rotate(-135deg);
  }
  .nav--mobile[open] {
    flex-basis: 100%;
  }
  .nav--mobile[open] summary {
    position: absolute;
    top: 14px;
    right: var(--gutter);
    height: calc(var(--header-h) - 28px);
    display: flex;
    align-items: center;
  }
  .nav--mobile nav {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--hairline-inner);
  }
  .nav--mobile nav a {
    display: block;
    padding: 17px 0;
    border-bottom: 1px solid var(--hairline-inner);
    color: var(--pine);
    text-decoration: none;
    font-size: 16px;
  }
  .nav--mobile nav :global(a.textlink) {
    display: block;
    border-bottom: 0;
    padding: 17px 0 10px;
    font-size: 16px;
    color: var(--clay);
    font-weight: 500;
  }
  /* Solid background while the menu is open, so the page doesn't show through */
  .header:has(.nav--mobile[open]) {
    background: var(--cream);
  }

  @media (max-width: 720px) {
    .nav--inline {
      display: none;
    }
    .nav--mobile {
      display: block;
    }
  }
</style>
